      { id: "p113-11", question: "Schrijf 0,00045 in wetenschappelijke notatie.", answer: ["4,5 × 10^-4", "4.5 × 10^-4"] },
      { id: "p113-12", question: "Schrijf 3,2 × 10^5 als gewoon getal.", answer: ["320 000", "320000"] },
